# CNA Platform — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# See documentation/secrets-reference.md for every variable explained in full.
#
# Single-cloud usage: only fill the section for your target cloud.
# Both sections only needed for dual-cloud engagements.

# =============================================================================
# AZURE DISCOVERY
# =============================================================================
# Used by: cna discover azure, cna analyze --azure
# Auth method: DefaultAzureCredential (tries env vars, then az login, then managed identity)
AZURE_TENANT_ID=                          # Azure AD tenant ID (GUID)
AZURE_CLIENT_ID=                          # App registration or managed identity client ID
AZURE_CLIENT_SECRET=                      # App registration secret (leave blank if using az login)

# =============================================================================
# AZURE DELIVERY PORTAL
# =============================================================================
# Used by: cna publish --cloud azure
# Auth method: DefaultAzureCredential (same credential as discovery)
AZURE_STORAGE_ACCOUNT_NAME=               # Storage account for portal delivery (e.g. cnadeliveries)
AZURE_STORAGE_CONTAINER_ENGAGEMENTS=engagements

# =============================================================================
# AZURE AI (OPTIONAL — Phase D MCP enrichment)
# =============================================================================
# Used by: cna analyze (recommendation enrichment only — not required)
# If not set, platform falls back to offline recommendations (DD-003)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=                     # Leave blank to use DefaultAzureCredential
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure Key Vault (optional — used if you store secrets in Key Vault instead of .env)
AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net/

# =============================================================================
# AWS DISCOVERY
# =============================================================================
# Used by: cna discover aws, cna analyze --aws
# Auth method: STS AssumeRole via org management account
# For CI/CD: use OIDC (no keys needed). For local: set keys below OR use aws sso login.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=                        # Leave blank for SSO or instance profile
AWS_SECRET_ACCESS_KEY=                    # Leave blank for SSO or instance profile
AWS_SESSION_TOKEN=                        # Leave blank unless using temporary credentials
AWS_VENDOR_ACCOUNT_ID=                   # Your management/vendor account ID

# =============================================================================
# AWS DELIVERY PORTAL
# =============================================================================
# Used by: cna publish --cloud aws
# Auth method: OIDC in CI (cd-publish.yml). For local: IAM credentials above.
CNA_PUBLISH_BUCKET=                       # S3 bucket name (e.g. cna-deliverables-prod)

# =============================================================================
# MCP SERVERS (OPTIONAL — Phase D AI enrichment)
# =============================================================================
# Not required. If not set, offline recommendations are used (DD-003 fallback).
AWS_MCP_SERVER_URL=                       # awslabs/mcp endpoint if self-hosted
AZURE_MCP_SERVER_URL=                     # Azure MCP server endpoint if self-hosted

# =============================================================================
# NOTIFICATIONS (OPTIONAL)
# =============================================================================
TEAMS_WEBHOOK_URL=                        # MS Teams channel webhook for CRITICAL alerts
NOTIFICATION_EMAIL_FROM=assessments@yourorg.com

# =============================================================================
# PLATFORM
# =============================================================================
CNA_VERSION=0.1.0
CNA_LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
CNA_DATA_DIR=./engagements                # Where engagement folders are written
