# CNA Platform — copy to .env, never commit .env

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_ENGAGEMENTS=engagements

# Azure Key Vault
AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net/
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# AWS Vendor Account (delivery portal only)
AWS_VENDOR_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# MCP Servers
AWS_MCP_SERVER_URL=
AZURE_MCP_SERVER_URL=

# Notifications
TEAMS_WEBHOOK_URL=
NOTIFICATION_EMAIL_FROM=assessments@yourorg.com

# Platform
CNA_VERSION=0.1.0
CNA_LOG_LEVEL=INFO
CNA_DATA_DIR=./engagements
