# =============================================================================
# CNA Platform — AWS Migration Variables
# =============================================================================
# Copy to terraform.tfvars and fill in real values.
# Use TF_VAR_* environment variables for sensitive values in CI.
# =============================================================================

# Core
project_name = "cna"
environment  = "dev"
aws_region   = "us-east-2"

# Container Images
api_image    = "docker.io/your-namespace/cna:api-latest"
worker_image = "docker.io/your-namespace/cna:worker-latest"
web_image    = "docker.io/your-namespace/cna:web-latest"

# Docker Hub credentials
dockerhub_username = "your-dockerhub-user"
dockerhub_token    = "dckr_pat_XXXXXXXX"

# Database
db_instance_class          = "db.t4g.small"
db_allocated_storage       = 20
db_name                    = "cna"
db_username                = "cnaadmin"
db_password                = "CHANGE_ME_strong_password"
db_multi_az                = false
db_backup_retention_period = 7

# Authentication (Entra ID SSO)
entra_tenant_id     = "00000000-0000-0000-0000-000000000000"
entra_client_id     = "00000000-0000-0000-0000-000000000000"
entra_client_secret = "your-entra-client-secret"
nextauth_secret     = "generate-with-openssl-rand-base64-32"
nextauth_url        = ""  # Leave empty; will use CloudFront domain

# Credential encryption
credential_encryption_key = "generate-with-openssl-rand-base64-32"

# AI / OpenAI
openai_endpoint   = "https://api.openai.com/v1"
openai_deployment = "gpt-4"
openai_api_key    = "sk-..."

# Domain (optional — leave empty to use CloudFront default domain)
domain_name         = ""
acm_certificate_arn = ""

# GitHub
github_owner      = "your-github-org"
github_repository = "your-repo-name"
github_token      = "ghp_XXXXXXXX"
