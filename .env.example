# CNA Platform — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# See the GitHub Wiki pages "Secrets Reference" and "Deployment Guide"
# for every variable explained in full.
#
# TIP: Workflow 011-sync-keys.yml can download
# a populated .env from Azure Key Vault as a 1-day artifact.
#
# Single-cloud usage: only fill the section for your target cloud.
# Both sections only needed for dual-cloud engagements.

# =============================================================================
# GITHUB ACTIONS — SECRETS  (GitHub Settings → Secrets and variables → Actions)
# These are NOT set in .env. Documented here so the secrets checklist is in
# one place. See .github/workflows/README.md for full descriptions.
# =============================================================================
#
# Secret name                         | Description
# ------------------------------------|-----------------------------------------------
# AZURE_CLIENT_ID                     | OIDC app registration Client ID
# AZURE_TENANT_ID                     | Azure AD tenant GUID
# AZURE_SUBSCRIPTION_ID               | Azure subscription ID
# GHCR_PAT                            | GitHub PAT with read:packages for image pulls
# CNA_POSTGRES_ADMIN_PASSWORD         | PostgreSQL admin password (min 8 chars)
# CNA_ENTRA_CLIENT_SECRET             | Entra ID OAuth2 client secret (NextAuth)
# CNA_NEXTAUTH_SECRET                 | NextAuth JWT signing secret (openssl rand -base64 32)
# CNA_CREDENTIAL_ENCRYPTION_KEY       | Base64 32-byte key for stored cloud credentials
# FRONTDOOR_CERTIFICATE_PFX_PASSWORD  | Password for custom TLS cert (optional)
# CNA_AWS_ROLE_ARN                    | ARN of CNA-Publish IAM role (OIDC)
# CNA_PUBLISH_BUCKET                  | S3 bucket name for AWS client delivery portal

# =============================================================================
# GITHUB ACTIONS — VARIABLES  (GitHub Settings → Secrets and variables → Variables)
# Non-sensitive identifiers consumed by workflows 000, 010, 011, 031, 032
# =============================================================================
#
# Variable name                  | Example value
# -------------------------------|---------------------------------------------
# TFSTATE_RESOURCE_GROUP         | rg-cna-tfstate
# TFSTATE_STORAGE_ACCOUNT        | stcna<customer>tfstate
# TFSTATE_CONTAINER              | tfstate
# CNA_ENTRA_CLIENT_ID            | 00000000-0000-0000-0000-000000000000
# CNA_NEXTAUTH_URL               | https://<frontdoor_endpoint_host_name>
# CNA_AI_ENGINE_DEFAULT          | foundry-claude
# FOUNDRY_CLAUDE_ENDPOINT        | none
# FOUNDRY_CLAUDE_MODEL           | claude-sonnet-4-6
# CNA_AZURE_MCP_ENDPOINT         | none
# CNA_AZURE_MCP_TRANSPORT        | sse
# CNA_AWS_MCP_ENDPOINT           | none
# CNA_AWS_MCP_TRANSPORT          | stdio
# CNA_DRAWIO_MCP_URL             | none
# APPLICATION_INSIGHTS_NAME      | none
# KEY_VAULT_NAME                 | none
# FRONTDOOR_CERTIFICATE_NAME     | cna-platform-cert  (Key Vault cert name)
# FRONTDOOR_CERTIFICATE_PFX_PATH | certs/cna-platform.pfx  (repo-relative path)

# =============================================================================
# AZURE IDENTITY — Local dev overrides
# =============================================================================
# Used by: cna discover azure, cna analyze --azure, cna publish --cloud azure
# Auth method: DefaultAzureCredential chain
#   Priority: env vars below → az login → managed identity (in CI/CD)
# Leave AZURE_CLIENT_ID and AZURE_CLIENT_SECRET blank when using `az login` locally.
AZURE_TENANT_ID=                          # Azure AD tenant GUID
AZURE_CLIENT_ID=                          # App registration or managed identity client ID
AZURE_CLIENT_SECRET=                      # App reg secret — leave blank for az login

# =============================================================================
# AZURE DISCOVERY
# =============================================================================
# Used by: cna discover azure
# No extra vars needed beyond AZURE_TENANT_ID above.
# Required RBAC: Reader at root Management Group + Management Group Reader at tenant root.
# Dynamic region enumeration: handled by DefaultAzureCredential + ARM API (DD-006).

# =============================================================================
# AZURE DELIVERY PORTAL
# =============================================================================
# Used by: cna publish --cloud azure
# Storage account provisioned by Terraform (providers/azure/storage).
# DefaultAzureCredential handles auth — no key needed in managed identity environments.
AZURE_STORAGE_ACCOUNT_NAME=               # e.g. stcnadeliveriesdeveus  (Terraform output)
AZURE_STORAGE_CONTAINER_ENGAGEMENTS=engagements

# =============================================================================
# AZURE OPENAI (OPTIONAL — not provisioned by current Terraform)
# =============================================================================
# Used only if an Azure OpenAI endpoint is supplied out-of-band.
# Current Terraform provisions Microsoft Foundry instead. Azure OpenAI should
# not be treated as a first-class deployed provider unless Terraform also adds
# the Azure OpenAI resource, private networking, RBAC, model deployment, and
# app environment variables.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=                     # Leave blank — use DefaultAzureCredential when enabled

# =============================================================================
# GENAI ENGINE SWITCHING
# =============================================================================
# Used by: cna-web analysis and deliverable generation.
# In Azure, these are injected by Terraform in workflow 031.
# Active engine is stored in Postgres setting ai.activeEngine; this default is
# used when that setting does not exist.
CNA_AI_ENGINE_DEFAULT=foundry-claude      # azure-openai | foundry-claude
FOUNDRY_CLAUDE_ENDPOINT=                  # Terraform-injected private Foundry Claude Messages API endpoint
FOUNDRY_CLAUDE_MODEL=claude-sonnet-4-6
FOUNDRY_CLAUDE_API_KEY=                   # Local-only compatibility override; Azure deploys use managed identity
# Azure deploy validation must confirm Foundry DNS resolves privately from the
# VNet and managed identity can invoke Claude without API-key fallback.

# =============================================================================
# AZURE KEY VAULT
# =============================================================================
# Used by: KeyVaultCredentialProvider (contractor workflow, cna/core/auth.py)
# Provisioned by Terraform (providers/azure/identity).
# Only required when storing secrets in Key Vault instead of .env (recommended for prod).
# Key Vault secrets written by Terraform:
#   cna-applicationinsights-connection-string
AZURE_KEY_VAULT_URL=                      # e.g. https://cna-dev-scus-kv.vault.azure.net/

# =============================================================================
# AZURE MONITORING
# =============================================================================
# Connection string injected by Terraform at runtime via Container App env vars (runtime module).
# Set here for local dev only — in prod, pulled from Key Vault:
#   secret name: cna-applicationinsights-connection-string
APPLICATIONINSIGHTS_CONNECTION_STRING=    # InstrumentationKey=...;IngestionEndpoint=...

# =============================================================================
# WEB PLATFORM (cna-web / Next.js 15)
# =============================================================================
# These are needed locally. In Azure, they are set via Container App secrets
# and env vars managed by Terraform (infra/terraform/environments/azure/dev/main.tf).
# See apps/cna-web/.env.example for the full web app reference.
DATABASE_URL=postgresql://cnaadmin:devpassword@localhost:5432/cna?sslmode=disable
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=your-entra-client-secret-here
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000

# =============================================================================
# CONTAINER REGISTRY
# =============================================================================
# CNA images are published to GHCR via 030-build-images.yml.
# No ACR is provisioned — GHCR is the registry for all three container images.
# Container Apps pull from GHCR using SystemAssigned managed identity.
# No registry credentials needed in CI — GITHUB_TOKEN handles GHCR auth.
# For local docker testing only:
GHCR_IMAGE_API=ghcr.io/saulpatinojr/cna-api:latest
GHCR_IMAGE_WORKER=ghcr.io/saulpatinojr/cna-worker:latest
GHCR_IMAGE_WEB=ghcr.io/saulpatinojr/cna-web:latest

# =============================================================================
# AWS DISCOVERY
# =============================================================================
# Used by: cna discover aws, cna analyze --aws
# Auth method: STS AssumeRole via org management account (DD-006)
# For CI/CD: use OIDC (no keys). For local: set keys below OR use aws sso login.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=                        # Leave blank for SSO or instance profile
AWS_SECRET_ACCESS_KEY=                    # Leave blank for SSO or instance profile
AWS_SESSION_TOKEN=                        # Leave blank unless using temporary credentials
AWS_VENDOR_ACCOUNT_ID=                    # Your management/vendor account ID

# =============================================================================
# AWS DELIVERY PORTAL
# =============================================================================
# Used by: cna publish --cloud aws
# Auth: OIDC in CI (workflow 022). Local: IAM credentials above.
CNA_PUBLISH_BUCKET=                       # S3 bucket name (e.g. cna-deliverables-prod)

# =============================================================================
# MCP SERVERS (OPTIONAL — Phase D AI enrichment)
# =============================================================================
# If unset, offline recommendations are used (DD-003 fallback).
CNA_MCP_SERVER_URL=none                   # default MCP server (fallback when cloud-specific URLs not set)
AWS_MCP_SERVER_URL=                       # awslabs/mcp endpoint if self-hosted
AZURE_MCP_SERVER_URL=                     # Azure MCP server endpoint if self-hosted
CNA_AZURE_MCP_ENDPOINT=                   # Terraform/GitHub variable name used by cna-web
CNA_AZURE_MCP_TRANSPORT=sse
CNA_AWS_MCP_ENDPOINT=                     # Terraform/GitHub variable name used by cna-web
CNA_AWS_MCP_TRANSPORT=stdio
CNA_DRAWIO_MCP_URL=                       # draw.io MCP endpoint exposed by the app/deployment

# =============================================================================
# NOTIFICATIONS (OPTIONAL)
# =============================================================================
TEAMS_WEBHOOK_URL=                        # MS Teams channel webhook for CRITICAL alerts (DD-016)
NOTIFICATION_EMAIL_FROM=assessments@yourorg.com

# =============================================================================
# PLATFORM
# =============================================================================
CNA_VERSION=1.0.0
CNA_LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
CNA_DATA_DIR=./engagements                # Where engagement folders are written
CNA_SKIP_RASTER=false                     # true = skip PNG/PDF diagram export (faster local dev)
CNA_DIAGRAM_DPI=150                       # PNG export DPI (configurable per Gap 11 fix)
CNA_DIAGRAM_MAX_PX=4096                   # Max PNG dimension cap in pixels
